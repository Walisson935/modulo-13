
import pandas as pd
import plotly.express as px


df = pd.read_csv("supermercado.csv")
df.head()


print(df.info())
print(df.describe())

df.isnull().sum()


print("Número de produtos:", len(df))
print("Número de categorias:", df["Categoria"].nunique())
print("Número de marcas:", df["Marca"].nunique())


print("Preço médio:", df["Preco_Normal"].mean())
print("Mediana:", df["Preco_Normal"].median())
print("Maior preço:", df["Preco_Normal"].max())
print("Menor preço:", df["Preco_Normal"].min())
print("Desvio padrão:", df["Preco_Normal"].std())

categoria = (
    df["Categoria"]
      .value_counts()
      .reset_index()
)


categoria.columns = ["Categoria","Quantidade"]
categoria


fig = px.bar(
    categoria,
    x="Categoria",
    y="Quantidade",
    text="Quantidade",
    title="Quantidade de Produtos por Categoria"
)


fig.show()


media = (
    df.groupby("Categoria")["Preco_Normal"]
      .mean()
      .reset_index()
)


fig = px.bar(
    media,
    x="Categoria",
    y="Preco_Normal",
    color="Categoria",
    title="Preço Médio por Categoria"
)


fig.show()


marca = (
    df["Marca"]
      .value_counts()
      .head(10)
      .reset_index()
)


marca.columns = ["Marca","Quantidade"]


fig = px.bar(
    marca,
    x="Marca",
    y="Quantidade",
    title="Top 10 Marcas"
)


fig.show()
