# ============================================================
# ANÁLISE EXPLORATÓRIA DE DADOS - SUPERMERCADO
# ============================================================

import pandas as pd
import plotly.express as px

# ============================================================
# 1. CARREGAMENTO DOS DADOS
# ============================================================

df = pd.read_csv("supermercado.csv")

print("Dados carregados com sucesso!")
print(f"Quantidade de registros: {len(df)}")

# Visualização inicial
display(df.head())


# ============================================================
# 2. INFORMAÇÕES GERAIS DA BASE
# ============================================================

print("\n--- INFORMAÇÕES DA BASE ---")
df.info()

print("\n--- ESTATÍSTICAS DESCRITIVAS ---")
display(df.describe())


# ============================================================
# 3. VERIFICAÇÃO DE VALORES NULOS
# ============================================================

print("\n--- VALORES NULOS ---")
print(df.isnull().sum())


# ============================================================
# 4. INFORMAÇÕES GERAIS SOBRE OS PRODUTOS
# ============================================================

print("\n--- INFORMAÇÕES GERAIS ---")

print("Número de produtos:", len(df))
print("Número de categorias:", df["Categoria"].nunique())
print("Número de marcas:", df["Marca"].nunique())


# ============================================================
# 5. ESTATÍSTICAS DE PREÇO
# ============================================================

print("\n--- ESTATÍSTICAS DE PREÇO ---")

print(f"Preço médio: R$ {df['Preco_Normal'].mean():.2f}")
print(f"Mediana: R$ {df['Preco_Normal'].median():.2f}")
print(f"Maior preço: R$ {df['Preco_Normal'].max():.2f}")
print(f"Menor preço: R$ {df['Preco_Normal'].min():.2f}")
print(f"Desvio padrão: R$ {df['Preco_Normal'].std():.2f}")


# ============================================================
# 6. QUANTIDADE DE PRODUTOS POR CATEGORIA
# ============================================================

quantidade_categoria = (
    df["Categoria"]
    .value_counts()
    .reset_index()
)

quantidade_categoria.columns = ["Categoria", "Quantidade"]

print("\n--- QUANTIDADE DE PRODUTOS POR CATEGORIA ---")
display(quantidade_categoria)


fig = px.bar(
    quantidade_categoria,
    x="Categoria",
    y="Quantidade",
    text="Quantidade",
    title="Quantidade de Produtos por Categoria",
    labels={
        "Quantidade": "Quantidade de Produtos",
        "Categoria": "Categoria"
    }
)

fig.show()


# ============================================================
# 7. PREÇO MÉDIO POR CATEGORIA
# ============================================================

preco_medio_categoria = (
    df.groupby("Categoria")["Preco_Normal"]
    .mean()
    .reset_index()
)

print("\n--- PREÇO MÉDIO POR CATEGORIA ---")
display(preco_medio_categoria)


fig = px.bar(
    preco_medio_categoria,
    x="Categoria",
    y="Preco_Normal",
    color="Categoria",
    title="Preço Médio por Categoria",
    labels={
        "Preco_Normal": "Preço Médio (R$)",
        "Categoria": "Categoria"
    }
)

fig.show()


# ============================================================
# 8. MÉDIA E MEDIANA DE PREÇO POR CATEGORIA
# ============================================================

preco_categoria = (
    df.groupby("Categoria")["Preco_Normal"]
    .agg(
        Media="mean",
        Mediana="median"
    )
    .reset_index()
)

print("\n--- MÉDIA E MEDIANA DE PREÇO POR CATEGORIA ---")
display(preco_categoria)


# Mediana geral dos preços
mediana_geral = df["Preco_Normal"].median()

print(f"\nMediana geral dos preços: R$ {mediana_geral:.2f}")


# Identificar categorias acima ou abaixo da mediana geral
preco_categoria["Comparacao_Mediana_Geral"] = (
    preco_categoria["Media"]
    .apply(
        lambda x: "Acima da mediana geral"
        if x > mediana_geral
        else "Abaixo ou igual à mediana geral"
    )
)

print("\n--- COMPARAÇÃO COM A MEDIANA GERAL ---")
display(preco_categoria)


# ============================================================
# 9. DESVIO PADRÃO POR CATEGORIA
# ============================================================

dispersao_categoria = (
    df.groupby("Categoria")["Preco_Normal"]
    .agg(
        Media="mean",
        Mediana="median",
        Desvio_Padrao="std"
    )
    .reset_index()
    .sort_values(
        by="Desvio_Padrao",
        ascending=False
    )
)

print("\n--- DESVIO PADRÃO POR CATEGORIA ---")
display(dispersao_categoria)


# Categoria com maior dispersão
categoria_maior_desvio = (
    dispersao_categoria
    .iloc[0]["Categoria"]
)

maior_desvio = (
    dispersao_categoria
    .iloc[0]["Desvio_Padrao"]
)

print(
    f"\nCategoria com maior dispersão: "
    f"{categoria_maior_desvio}"
)

print(
    f"Desvio padrão: R$ {maior_desvio:.2f}"
)


# ============================================================
# 10. BOXPLOT DA CATEGORIA COM MAIOR DESVIO PADRÃO
# ============================================================

df_maior_desvio = df[
    df["Categoria"] == categoria_maior_desvio
].copy()

print(
    f"\nQuantidade de produtos na categoria "
    f"{categoria_maior_desvio}: {len(df_maior_desvio)}"
)


fig = px.box(
    df_maior_desvio,
    y="Preco_Normal",
    points="outliers",
    title=(
        f"Distribuição dos Preços - "
        f"{categoria_maior_desvio}"
    ),
    labels={
        "Preco_Normal": "Preço Normal (R$)"
    }
)

fig.show()


# ============================================================
# 11. IDENTIFICAÇÃO DE OUTLIERS
# ============================================================

q1 = df_maior_desvio["Preco_Normal"].quantile(0.25)
q3 = df_maior_desvio["Preco_Normal"].quantile(0.75)

iqr = q3 - q1

limite_inferior = q1 - (1.5 * iqr)
limite_superior = q3 + (1.5 * iqr)

outliers = df_maior_desvio[
    (df_maior_desvio["Preco_Normal"] < limite_inferior)
    |
    (df_maior_desvio["Preco_Normal"] > limite_superior)
]

print("\n--- ANÁLISE DE OUTLIERS ---")

print(f"Primeiro quartil (Q1): R$ {q1:.2f}")
print(f"Terceiro quartil (Q3): R$ {q3:.2f}")
print(f"IQR: R$ {iqr:.2f}")

print(f"Limite inferior: R$ {limite_inferior:.2f}")
print(f"Limite superior: R$ {limite_superior:.2f}")

print(f"\nQuantidade de outliers: {len(outliers)}")

if len(outliers) > 0:
    print("\nProdutos considerados outliers:")
    display(outliers)
else:
    print("\nNão foram encontrados outliers.")


# ============================================================
# 12. MÉDIA DE DESCONTO POR CATEGORIA
# ============================================================

desconto_categoria = (
    df.groupby("Categoria")["Desconto"]
    .mean()
    .reset_index()
    .sort_values(
        by="Desconto",
        ascending=False
    )
)

print("\n--- DESCONTO MÉDIO POR CATEGORIA ---")
display(desconto_categoria)


# Categoria com maior desconto
categoria_maior_desconto = (
    desconto_categoria
    .iloc[0]["Categoria"]
)

maior_desconto = (
    desconto_categoria
    .iloc[0]["Desconto"]
)

print(
    f"\nCategoria com maior desconto médio: "
    f"{categoria_maior_desconto}"
)

print(
    f"Desconto médio: {maior_desconto:.2f}"
)


# ============================================================
# 13. GRÁFICO DE DESCONTO MÉDIO POR CATEGORIA
# ============================================================

fig = px.bar(
    desconto_categoria,
    x="Categoria",
    y="Desconto",
    color="Categoria",
    text_auto=".2f",
    title="Desconto Médio por Categoria",
    labels={
        "Categoria": "Categoria",
        "Desconto": "Desconto Médio"
    }
)

fig.show()


# ============================================================
# 14. TOP 10 MARCAS
# ============================================================

marcas = (
    df["Marca"]
    .value_counts()
    .head(10)
    .reset_index()
)

marcas.columns = ["Marca", "Quantidade"]

print("\n--- TOP 10 MARCAS ---")
display(marcas)


fig = px.bar(
    marcas,
    x="Marca",
    y="Quantidade",
    text="Quantidade",
    title="Top 10 Marcas",
    labels={
        "Marca": "Marca",
        "Quantidade": "Quantidade de Produtos"
    }
)

fig.show()


# ============================================================
# 15. DESCONTO MÉDIO POR CATEGORIA E MARCA
# ============================================================

desconto_categoria_marca = (
    df.groupby(
        ["Categoria", "Marca"]
    )["Desconto"]
    .mean()
    .reset_index()
)

print(
    "\n--- DESCONTO MÉDIO POR CATEGORIA E MARCA ---"
)

display(desconto_categoria_marca)


# ============================================================
# 16. GRÁFICO INTERATIVO CATEGORIA + MARCA
# ============================================================

fig = px.bar(
    desconto_categoria_marca,
    x="Marca",
    y="Desconto",
    color="Categoria",
    hover_data=[
        "Categoria",
        "Marca",
        "Desconto"
    ],
    title="Desconto Médio por Categoria e Marca",
    labels={
        "Marca": "Marca",
        "Desconto": "Desconto Médio",
        "Categoria": "Categoria"
    }
)

fig.show()


# ============================================================
# 17. RESUMO FINAL DA ANÁLISE
# ============================================================

print("\n" + "=" * 60)
print("RESUMO FINAL DA ANÁLISE")
print("=" * 60)

print(
    f"Total de produtos: {len(df)}"
)

print(
    f"Total de categorias: {df['Categoria'].nunique()}"
)

print(
    f"Total de marcas: {df['Marca'].nunique()}"
)

print(
    f"Preço médio geral: R$ {df['Preco_Normal'].mean():.2f}"
)

print(
    f"Mediana geral: R$ {df['Preco_Normal'].median():.2f}"
)

print(
    f"Categoria com maior desvio padrão: "
    f"{categoria_maior_desvio}"
)

print(
    f"Categoria com maior desconto médio: "
    f"{categoria_maior_desconto}"
)

print(
    f"Quantidade de outliers na categoria "
    f"com maior dispersão: {len(outliers)}"
)

print("=" * 60)
